{
  "name": "cafeteria",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/lint": "21.2.4",
    "@commitlint/load": "21.2.4",
    "@jest/globals": "30.5.2",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "amqplib": "2.4.0",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.4",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "redis": "6.3.1",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "lint": "eslint apps packages scripts tests playwright.config.ts vitest.config.ts",
    "format:check": "prettier --check --config .prettierrc.json apps packages scripts tests ../scripts/ci ../.github playwright.config.ts vitest.config.ts package.json pnpm-workspace.yaml turbo.json tsconfig.json eslint.config.mjs .prettierrc.json",
    "build": "turbo run build",
    "env:check": "tsx scripts/env-check.ts",
    "test:config": "vitest run tests/unit/config.spec.ts",
    "test:unit": "vitest run --coverage && node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/unit/jest.config.ts --coverage",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config tests/integration/jest.config.ts --runInBand --coverage",
    "coverage:merge": "tsx scripts/coverage-merge.ts",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --config tests/smoke/playwright.config.ts",
    "dev": "tsx scripts/dev.ts",
    "infra:check": "tsx scripts/infra-check.ts",
    "prepare": "cd .. && husky",
    "flags:set": "tsx scripts/flags-set.ts",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "candidate:package": "tsx scripts/ci/package-candidate.ts"
  }
}
